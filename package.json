{
  "name": "total-arc",
  "version": "1.1.0",
  "private": true,
  "description": "Total ARC - enterprise assurance, risk and control platform",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:bootstrap-admin": "node scripts/bootstrap-admin.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "build:next": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.9.3",
    "@opennextjs/cloudflare": "1.20.6",
    "wrangler": "4.135.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1",
    "postcss": "^8.5.28"
  }
}
