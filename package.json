    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.9.3"
  }
