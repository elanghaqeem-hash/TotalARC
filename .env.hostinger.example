# TotalARC - Hostinger Node.js
NODE_ENV=production
TOTAL_ARC_HOSTINGER=1

# Runtime database.
# d1-http = use the existing Cloudflare D1 database (fastest migration, keeps
# existing data and password hashes exactly as they are).
# sqlite = local Hostinger SQLite database through Prisma.
TOTAL_ARC_DB_DRIVER=d1-http
TOTAL_ARC_SQLITE_PATH=data/totalarc.db

# Authentication
# Generate a new random server-side secret (minimum 32 chars).
TOTAL_ARC_AUTH_SECRET=
TOTAL_ARC_BOOTSTRAP_ADMIN_EMAIL=serayamg@gmail.com
TOTAL_ARC_BOOTSTRAP_ADMIN_NAME=Super Administrator
# For an existing D1/migrated AuthUser this can remain empty.
# For a brand-new empty SQLite database, set this to the desired existing
# TotalARC password for serayamg@gmail.com. Never commit the plaintext value.
TOTAL_ARC_BOOTSTRAP_ADMIN_PASSWORD=
TOTAL_ARC_HEALTHCHECK_TOKEN=

# Required only when TOTAL_ARC_DB_DRIVER=d1-http or when running the importer.
CLOUDFLARE_ACCOUNT_ID=
TOTAL_ARC_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=
TOTAL_ARC_D1_HTTP_TIMEOUT_MS=15000

# Optional AI providers
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=

AI_DEFAULT_SENSITIVITY=confidential
AI_ALLOW_EXTERNAL_FOR_SENSITIVE=false
AI_REDACT_EXTERNAL=true
AI_TIMEOUT_MS=25000
AI_MAX_INPUT_CHARS=60000
AI_MAX_OUTPUT_TOKENS=4096
