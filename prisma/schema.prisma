datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. INSTITUTION & TENANCY
// -------------------------------------------------------------
model Institution {
  id                  String   @id @default(uuid())
  name                String
  legalName           String
  shortName           String
  institutionType     String   // Corporation, Public Company, State-Owned Enterprise, etc.
  country             String   @default("Indonesia")
  provinceState       String?
  city                String?
  registeredAddress   String?
  operationalAddress  String?
  website             String?
  generalEmail        String?
  telephone           String?
  yearEstablished     Int?
  registrationNumber  String?
  taxId               String?
  parentCompany       String?
  holdingCompany      String?
  stockExchange       String?
  ticker              String?
  logo                String?
  employeeCount       String?
  revenueRange        String?
  businessModel       String?  // B2B, B2C, etc.
  operatingModel      String?  // Centralized, Federated, etc.
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  legalEntities       LegalEntity[]
  organizationUnits   OrganizationUnit[]
  users               User[]
  processes           BusinessProcess[]
  risks               RiskMaster[]
  controls            ControlMaster[]
  campaigns           AssessmentCampaign[]
  issues              Issue[]
  auditLogs           AuditLog[]
  financialAccounts   FinancialAccount[]
  ipeRegisters        IPERegister[]
  attestations        ManagementAttestation[]
  tasks               Task[]
  aiSuggestions       AISuggestion[]
}

model IndustryClassification {
  id        String   @id @default(uuid())
  industry  String
  sector    String
  subsector String
  code      String?
  createdAt DateTime @default(now())

  @@unique([industry, sector, subsector])
}

model LegalEntity {
  id            String   @id @default(uuid())
  institutionId String
  code          String
  name          String
  country       String   @default("Indonesia")
  taxId         String?
  createdAt     DateTime @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  orgUnits      OrganizationUnit[]
  processes     BusinessProcess[]
}

model OrganizationUnit {
  id            String   @id @default(uuid())
  institutionId String
  legalEntityId String?
  parentId      String?
  type          String   // Directorate, Division, Department, Unit, Team
  code          String
  name          String
  headName      String?
  headEmail     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  legalEntity   LegalEntity? @relation(fields: [legalEntityId], references: [id])
  parent        OrganizationUnit? @relation("OrgHierarchy", fields: [parentId], references: [id])
  children      OrganizationUnit[] @relation("OrgHierarchy")
  processes     BusinessProcess[]
}

model User {
  id            String   @id @default(uuid())
  institutionId String
  name          String
  email         String   @unique
  role          String   // Admin, ProcessOwner, ControlOwner, Tester, Reviewer, Executive, Auditor
  department    String?
  active              Boolean  @default(true)
  passwordHash        String?
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  sessionVersion      Int      @default(1)
  lastLoginAt         DateTime?
  lastLoginIp         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  tasksAssigned Task[]      @relation("TaskAssignee")
}

model Framework {
  id          String   @id @default(uuid())
  code        String   @unique // COSO-IC, ISO-31000, ISO-27001, SOX, COBIT, NIST-CSF
  name        String
  category    String
  description String?
  applicability String @default("Applicable") // Applicable, Reference, N/A
  createdAt   DateTime @default(now())
}

model Regulation {
  id           String   @id @default(uuid())
  regulator    String   // OJK, BI, Kominfo, SEC, etc.
  name         String
  code         String
  jurisdiction String   @default("Indonesia")
  requirement  String?
  frequency    String?  // Monthly, Quarterly, Annual
  createdAt    DateTime @default(now())

  @@unique([regulator, code])
}

model SystemApplication {
  id             String   @id @default(uuid())
  code           String
  name           String
  type           String   // Internal, External, SaaS, ERP, Core
  cloudOnPrem    String   @default("Cloud")
  criticality    String   // Critical, High, Medium, Low
  systemOwner    String?
  vendor         String?
  dataClass      String?  // Confidential, Restricted, Public
  createdAt      DateTime @default(now())
}

// -------------------------------------------------------------
// 2. PROCESS ARCHITECTURE & BPM
// -------------------------------------------------------------
model ProcessCategory {
  id          String   @id @default(uuid())
  code        String
  name        String
  description String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  processes   BusinessProcess[]
}

model BusinessProcess {
  id              String   @id @default(uuid())
  institutionId   String
  legalEntityId   String?
  orgUnitId       String?
  categoryId      String
  processId       String   // e.g. PRC-P2P-001
  name            String   // e.g. Procure to Pay
  level           Int      @default(2) // Level 0 to Level 5
  parentProcessId String?
  description     String?
  ownerName       String
  ownerEmail      String?
  managerName     String?
  criticality     String   @default("Critical") // Critical, High, Medium, Low
  classification  String   @default("Core")     // Core, Support, Management, Control
  isIcofrRelevant Boolean  @default(false)
  status          String   @default("Approved") // Draft, Submitted, Under Review, Approved, Published
  version         String   @default("1.0")
  effectiveDate   DateTime @default(now())
  reviewDate      DateTime?
  tags            String?  // Comma separated tags
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  legalEntity     LegalEntity?     @relation(fields: [legalEntityId], references: [id])
  orgUnit         OrganizationUnit? @relation(fields: [orgUnitId], references: [id])
  category        ProcessCategory  @relation(fields: [categoryId], references: [id])
  parent          BusinessProcess? @relation("ProcessHierarchy", fields: [parentProcessId], references: [id])
  children        BusinessProcess[] @relation("ProcessHierarchy")
  
  activities      ProcessActivity[]
  objectives      ProcessObjective[]
  sipoc           SIPOC?
  risks           RiskMaster[]
  controls        ControlMaster[]
  todTests        ToDTest[]
  toeTests        ToETest[]
  issues          Issue[]
  aiSuggestions   AISuggestion[]

  @@index([institutionId, status])
  @@unique([institutionId, processId])
}

model ProcessActivity {
  id              String   @id @default(uuid())
  processId       String
  activityId      String   // ACT-001
  name            String
  description     String?
  performer       String?
  nature          String   @default("Manual") // Manual, Automated, Hybrid
  frequency       String   @default("Per Transaction")
  inputData       String?
  outputData      String?
  systemUsed      String?
  sla             String?
  orderIndex      Int      @default(0)
  createdAt       DateTime @default(now())

  process         BusinessProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  risks           RiskMaster[]
  controls        ControlMaster[]
}

model ProcessObjective {
  id              String   @id @default(uuid())
  processId       String
  objective       String
  strategicGoal   String?
  expectedOutcome String?
  kpi             String?
  kri             String?
  sla             String?
  createdAt       DateTime @default(now())

  process         BusinessProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
}

model SIPOC {
  id          String   @id @default(uuid())
  processId   String   @unique
  suppliers   String?  // JSON or text: Suppliers
  inputs      String?  // Inputs
  processSteps String? // Summary of steps
  outputs     String?  // Outputs
  customers   String?  // Customers
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  process     BusinessProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// 3. RISK UNIVERSE
// -------------------------------------------------------------
model RiskMaster {
  id              String   @id @default(uuid())
  institutionId   String
  processId       String
  activityId      String?
  riskId          String   // e.g. RSK-P2P-001
  name            String
  description     String
  cause           String
  event           String
  impact          String
  category        String   // Operational, Financial Reporting, Compliance, Technology, etc.
  ownerName       String
  
  // Inherent Risk
  inherentLikelihood Int   @default(3) // 1 to 5
  inherentImpact     Int   @default(4) // 1 to 5
  inherentScore      Int   @default(12) // Likelihood x Impact
  inherentRating     String @default("High") // Low, Medium, High, Critical

  // Residual Risk
  residualLikelihood Int   @default(2)
  residualImpact     Int   @default(3)
  residualScore      Int   @default(6)
  residualRating     String @default("Medium") // Low, Medium, High, Critical
  riskTreatment      String @default("Reduce") // Accept, Reduce, Avoid, Transfer

  status          String   @default("Active")
  version         String   @default("1.0")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  process         BusinessProcess   @relation(fields: [processId], references: [id], onDelete: Cascade)
  activity        ProcessActivity?  @relation(fields: [activityId], references: [id])
  controls        ControlRiskMapping[]
  todTests        ToDTest[]
  toeTests        ToETest[]
  issues          Issue[]
  riskAcceptances RiskAcceptance[]

  @@index([institutionId, status])
  @@unique([institutionId, riskId])
}

// -------------------------------------------------------------
// 4. CONTROL LIBRARY
// -------------------------------------------------------------
model ControlMaster {
  id                 String   @id @default(uuid())
  institutionId      String
  processId          String
  activityId         String?
  controlId          String   // e.g. CTRL-P2P-001
  name               String
  description        String
  objective          String
  controlOwner       String
  performer          String?
  reviewer           String?
  type               String   @default("Preventive") // Preventive, Detective, Corrective
  nature             String   @default("IT Dependent Manual") // Manual, IT Dependent Manual, Automated
  method             String   @default("Approval") // Approval, Authorization, Reconciliation, Validation, etc.
  frequency          String   @default("Per Transaction") // Real Time, Daily, Weekly, Monthly, Per Transaction, etc.
  isKeyControl       Boolean  @default(true)
  keyControlRationale String?
  isIcofrKey         Boolean  @default(true)
  isItgc             Boolean  @default(false)
  evidenceRequirement String?
  systemDependency   String?  // e.g. SAP ERP, Oracle
  frameworkMapping   String?  // e.g. COSO Princ. 10, SOX 404, ISO 27001 A.9
  regulationMapping  String?  // e.g. OJK POJK 13
  designAssessment   String   @default("Effective") // Effective, Partially Effective, Ineffective, Not Assessed
  operatingStatus    String   @default("Effective") // Effective, Partially Effective, Ineffective, Not Assessed
  overallHealth      String   @default("Healthy") // Healthy, Attention Required, Deficient, Not Assessed
  healthRationale    String?
  version            String   @default("1.0")
  status             String   @default("Active")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  institution        Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  process            BusinessProcess      @relation(fields: [processId], references: [id], onDelete: Cascade)
  activity           ProcessActivity?     @relation(fields: [activityId], references: [id])
  risks              ControlRiskMapping[]
  csaResponses       CSAResponse[]
  todTests           ToDTest[]
  toeTests           ToETest[]
  issues             Issue[]
  monitoringRules    MonitoringRule[]
  certifications     ControlCertification[]

  @@index([institutionId, status])
  @@unique([institutionId, controlId])
}

model ControlRiskMapping {
  id        String   @id @default(uuid())
  controlId String
  riskId    String
  createdAt DateTime @default(now())

  control   ControlMaster @relation(fields: [controlId], references: [id], onDelete: Cascade)
  risk      RiskMaster    @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@unique([controlId, riskId])
}

// -------------------------------------------------------------
// 5. RCSA & CSA WORKSPACE
// -------------------------------------------------------------
model AssessmentCampaign {
  id            String   @id @default(uuid())
  institutionId String
  name          String   // e.g. Annual RCSA 2026 Q3
  type          String   @default("RCSA") // RCSA, CSA, ICOFR
  period        String   @default("2026-Q3")
  startDate     DateTime
  dueDate       DateTime
  status        String   @default("In Progress") // Draft, In Progress, Review, Completed
  ownerName     String
  approverName  String?
  createdAt     DateTime @default(now())

  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  csaResponses  CSAResponse[]
}

model CSAResponse {
  id              String   @id @default(uuid())
  campaignId      String
  controlId       String
  wasPerformed    Boolean  @default(true)
  frequencyMet    Boolean  @default(true)
  evidenceAttached Boolean @default(true)
  exceptionsFound Boolean  @default(false)
  exceptionCount  Int      @default(0)
  processChanged  Boolean  @default(false)
  controlChanged  Boolean  @default(false)
  csaConclusion   String   @default("Effective") // Effective, Partially Effective, Ineffective, Not Performed
  assessorNotes   String?
  assessorName    String
  assessedAt      DateTime @default(now())

  campaign        AssessmentCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  control         ControlMaster      @relation(fields: [controlId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// 6. ICOFR & FINANCIAL ASSERTIONS
// -------------------------------------------------------------
model FinancialAccount {
  id             String   @id @default(uuid())
  institutionId  String
  accountCode    String
  accountName    String
  financialStatement String // Balance Sheet, Income Statement, Cash Flow
  balanceAmount  Float    @default(0)
  isSignificant  Boolean  @default(false)
  scopingRationale String?
  fraudExposure  String   @default("Low") // High, Medium, Low
  complexity     String   @default("Medium")
  createdAt      DateTime @default(now())

  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  assertions     AccountAssertionMapping[]

  @@index([institutionId])
  @@unique([institutionId, accountCode])
}

model AccountAssertionMapping {
  id         String   @id @default(uuid())
  accountId  String
  assertion  String   // Existence, Completeness, Valuation, Rights & Obligations, Presentation
  isInScope  Boolean  @default(true)
  createdAt  DateTime @default(now())

  account    FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model IPERegister {
  id            String   @id @default(uuid())
  institutionId String
  reportName    String
  systemSource  String
  reportOwner   String
  parameters    String?
  logicSummary  String?
  completenessTested Boolean @default(true)
  accuracyTested     Boolean @default(true)
  evidenceDoc   String?
  createdAt     DateTime @default(now())

  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
}

// -------------------------------------------------------------
// 7. TESTING: WALKTHROUGH, ToD & ToE
// -------------------------------------------------------------
model Walkthrough {
  id           String   @id @default(uuid())
  controlId    String
  date         DateTime @default(now())
  participants String?
  transactionRef String?
  systemsInspected String?
  observations String?
  processChanged Boolean @default(false)
  conclusion   String   @default("Walkthrough Satisfactory")
  createdAt    DateTime @default(now())
}

model ToDTest {
  id               String   @id @default(uuid())
  testId           String   // e.g. TOD-P2P-001
  controlId        String
  processId        String
  riskId           String?
  testerName       String
  reviewerName     String?
  period           String   @default("2026-Annual")
  testObjective    String
  objectiveAlignment Boolean @default(true)
  riskCoverage     Boolean  @default(true)
  precisionAdequate Boolean @default(true)
  segregationDuties Boolean @default(true)
  evidenceSufficiency Boolean @default(true)
  observations     String?
  conclusion       String   @default("Effective Design") // Effective Design, Partially Effective Design, Ineffective Design
  status           String   @default("Approved") // Draft, Submitted, Approved
  testedAt         DateTime @default(now())

  control          ControlMaster   @relation(fields: [controlId], references: [id], onDelete: Cascade)
  process          BusinessProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  risk             RiskMaster?     @relation(fields: [riskId], references: [id])
}

model ToETest {
  id               String   @id @default(uuid())
  testId           String   // e.g. TOE-P2P-001
  controlId        String
  processId        String
  riskId           String?
  testerName       String
  reviewerName     String?
  period           String   @default("2026-Annual")
  populationSize   Int      @default(450)
  populationSource String   @default("ERP Payment Run Ledger")
  samplingMethod   String   @default("Risk-Based Sampling") // Random, Systematic, Judgmental, Risk-Based
  sampleSize       Int      @default(25)
  passCount        Int      @default(23)
  failCount        Int      @default(2)
  testerConclusion String   @default("Partially Effective") // Effective, Effective with Minor Exception, Partially Effective, Ineffective
  finalConclusion  String   @default("Partially Effective")
  status           String   @default("Completed") // Planned, In Progress, Completed, Reviewed
  notes            String?
  testedAt         DateTime @default(now())

  control          ControlMaster   @relation(fields: [controlId], references: [id], onDelete: Cascade)
  process          BusinessProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  risk             RiskMaster?     @relation(fields: [riskId], references: [id])
  samples          TestSample[]
  exceptions       TestingException[]
}

model TestSample {
  id             String   @id @default(uuid())
  toeTestId      String
  sampleNumber   Int
  transactionRef String   // e.g. TRX-2026-0891
  transactionDate DateTime
  amount         Float?
  attributesTested String? // JSON or text: Approval verified, amount verified, etc.
  result         String   @default("Pass") // Pass, Fail, N/A
  failureReason  String?
  evidenceRef    String?

  toeTest        ToETest  @relation(fields: [toeTestId], references: [id], onDelete: Cascade)
}

model TestingException {
  id             String   @id @default(uuid())
  toeTestId      String
  exceptionNumber String  // EXP-001
  sampleRef      String   // TRX-2026-0891
  description    String
  severity       String   @default("High") // High, Medium, Low
  status         String   @default("Confirmed Exception") // Open, Under Review, Confirmed Exception, False Positive, Resolved
  createdAt      DateTime @default(now())

  toeTest        ToETest  @relation(fields: [toeTestId], references: [id], onDelete: Cascade)
  deficiencies   ControlDeficiency[]
}

// -------------------------------------------------------------
// 8. DEFICIENCY, ROOT CAUSE & MAP REMEDIATION
// -------------------------------------------------------------
model ControlDeficiency {
  id             String   @id @default(uuid())
  exceptionId    String?
  deficiencyId   String   // DEF-2026-001
  title          String
  description    String
  classification String   @default("Control Deficiency") // Observation, Control Deficiency, Significant Deficiency, Material Weakness
  financialImpact Float?
  regulatoryImpact String?
  compensatingControls String?
  humanApproved  Boolean  @default(true)
  approvedBy     String?
  createdAt      DateTime @default(now())

  exception      TestingException? @relation(fields: [exceptionId], references: [id])
  rootCause      RootCauseAnalysis?
  issues         Issue[]
}

model RootCauseAnalysis {
  id             String   @id @default(uuid())
  deficiencyId   String   @unique
  method         String   @default("5 Why") // 5 Why, Fishbone, People-Process-Tech
  why1           String?
  why2           String?
  why3           String?
  why4           String?
  why5           String?
  category       String   @default("Process") // People, Process, Technology, Data, Governance
  rootCauseStatement String
  createdAt      DateTime @default(now())

  deficiency     ControlDeficiency @relation(fields: [deficiencyId], references: [id], onDelete: Cascade)
}

model Issue {
  id             String   @id @default(uuid())
  institutionId  String
  issueId        String   // ISS-2026-001
  source         String   @default("TOE") // CSA, RCSA, TOD, TOE, CCM, Internal Audit
  processId      String
  riskId         String?
  controlId      String?
  deficiencyId   String?
  title          String
  description    String
  severity       String   @default("High") // Critical, High, Medium, Low
  ownerName      String
  targetDate     DateTime
  status         String   @default("Closed") // Open, In Progress, Pending Retest, Closed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  institution    Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  process        BusinessProcess   @relation(fields: [processId], references: [id], onDelete: Cascade)
  risk           RiskMaster?       @relation(fields: [riskId], references: [id])
  control        ControlMaster?    @relation(fields: [controlId], references: [id])
  deficiency     ControlDeficiency? @relation(fields: [deficiencyId], references: [id])
  actionPlans    ManagementActionPlan[]
}

model ManagementActionPlan {
  id               String   @id @default(uuid())
  mapId            String   // MAP-2026-001
  issueId          String
  agreedAction     String
  recommendation   String?
  actionOwner      String
  approverName     String
  originalDueDate  DateTime
  revisedDueDate   DateTime?
  extensionCount   Int      @default(0)
  extensionReason  String?
  progressPercent  Int      @default(100) // 0 to 100
  status           String   @default("Closed") // Draft, Agreed, In Progress, Pending Validation, Completed by Owner, Pending Retest, Closed, Overdue
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  issue            Issue         @relation(fields: [issueId], references: [id], onDelete: Cascade)
  milestones       MAPMilestone[]
  retests          RetestRecord[]
}

model MAPMilestone {
  id            String   @id @default(uuid())
  mapId         String
  title         String
  owner         String
  dueDate       DateTime
  status        String   @default("Completed") // Pending, In Progress, Completed
  progressPercent Int    @default(100)
  evidenceDoc   String?
  createdAt     DateTime @default(now())

  map           ManagementActionPlan @relation(fields: [mapId], references: [id], onDelete: Cascade)
}

model RetestRecord {
  id               String   @id @default(uuid())
  mapId            String
  retestId         String   // RET-2026-001
  sampleCount      Int      @default(10)
  passedCount      Int      @default(10)
  failedCount      Int      @default(0)
  testerName       String
  reviewerName     String
  result           String   @default("Passed") // Passed, Partially Passed, Failed
  conclusionNotes  String?
  retestedAt       DateTime @default(now())

  map              ManagementActionPlan @relation(fields: [mapId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// 9. CONTINUOUS CONTROL MONITORING (CCM)
// -------------------------------------------------------------
model MonitoringRule {
  id               String   @id @default(uuid())
  ruleId           String   // CCM-RULE-001
  controlId        String
  name             String
  description      String
  dataSource       String   // ERP, HRIS, Active Directory, GL, CSV
  queryLogic       String
  frequency        String   @default("Real Time") // Real Time, Daily, Weekly, Monthly
  threshold        String   @default("0 Transactions")
  status           String   @default("Active") // Active, Paused
  lastRunDate      DateTime?
  lastStatus       String   @default("Healthy") // Healthy, Exception Detected, Failed
  createdAt        DateTime @default(now())

  control          ControlMaster   @relation(fields: [controlId], references: [id], onDelete: Cascade)
  runs             MonitoringRun[]
}

model MonitoringRun {
  id               String   @id @default(uuid())
  ruleId           String
  runTimestamp     DateTime @default(now())
  populationChecked Int     @default(120)
  exceptionsFound  Int      @default(0)
  status           String   @default("Healthy") // Healthy, Exception Detected, Failed
  details          String?

  rule             MonitoringRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  exceptions       CCMException[]
}

model CCMException {
  id               String   @id @default(uuid())
  runId            String
  transactionRef   String
  details          String
  detectedAt       DateTime @default(now())

  run              MonitoringRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// 10. CERTIFICATION, ATTESTATION & TASKS
// -------------------------------------------------------------
model ControlCertification {
  id              String   @id @default(uuid())
  controlId       String
  period          String   // 2026-Annual
  declarationText String
  certifierName   String
  certifierRole   String   // Control Owner
  status          String   @default("Certified") // Certified, Certified with Exception, Not Certified
  certifiedAt     DateTime @default(now())

  control         ControlMaster @relation(fields: [controlId], references: [id], onDelete: Cascade)
}

model ManagementAttestation {
  id              String   @id @default(uuid())
  institutionId   String
  period          String
  scopeSummary    String
  cfoSignOff      Boolean  @default(false)
  cfoName         String?
  croSignOff      Boolean  @default(false)
  croName         String?
  overallOpinion  String?
  attestedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@unique([institutionId, period])
}

model RiskAcceptance {
  id              String   @id @default(uuid())
  riskId          String
  reason          String
  compensatingControls String
  approvedBy      String
  expiryDate      DateTime
  status          String   @default("Active")
  createdAt       DateTime @default(now())

  risk            RiskMaster @relation(fields: [riskId], references: [id], onDelete: Cascade)
}

model Task {
  id              String   @id @default(uuid())
  institutionId   String
  userId          String?
  title           String
  type            String   // CSA, TOD, TOE, Review, MAP, Retest, Certification
  dueDate         DateTime
  priority        String   @default("High") // Critical, High, Medium
  status          String   @default("Pending") // Pending, In Progress, Completed, Overdue
  entityRef       String?  // Control ID, Test ID, etc.
  link            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user            User?    @relation("TaskAssignee", fields: [userId], references: [id])

  @@index([institutionId, status])
  @@index([userId, status])
}

model AISuggestion {
  id               String   @id @default(uuid())
  institutionId    String
  processId         String
  mode              String
  category          String
  description       String
  recommendation   String?
  suggestedRisk    String?
  suggestedControl String?
  model             String
  status            String   @default("Pending Review")
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime @default(now())

  institution      Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  process          BusinessProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([institutionId, status])
  @@index([processId])
}

model AuditLog {
  id            String   @id @default(uuid())
  institutionId String?
  userId        String?
  userName      String
  userRole      String
  action        String   // CREATE, UPDATE, APPROVE, RETEST, CLOSE, EXPORT
  entityType    String   // Process, Risk, Control, ToE, MAP, Certification
  recordId      String
  oldValue      String?
  newValue      String?
  reason        String?
  ipAddress     String?
  userAgent     String?
  correlationId String?
  timestamp     DateTime @default(now())

  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
}
