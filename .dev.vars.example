# Copy to .dev.vars for local OpenNext/Workers development.
# .dev.vars is ignored by git.
NEXTJS_ENV=development

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

GEMINI_MODEL=gemini-3.8-flash
CLOUDFLARE_AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=openrouter/free

AI_DEFAULT_SENSITIVITY=confidential
AI_ALLOW_EXTERNAL_FOR_SENSITIVE=false
AI_REDACT_EXTERNAL=true
AI_TIMEOUT_MS=25000
AI_MAX_INPUT_CHARS=60000
AI_MAX_OUTPUT_TOKENS=4096
