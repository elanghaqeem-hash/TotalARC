# Total ARC AI Gateway
# Server-side only. Never prefix these variables with NEXT_PUBLIC_.

# Provider API keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Models
GEMINI_MODEL=gemini-3.8-flash
CLOUDFLARE_AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=openrouter/free

# Optional OpenRouter attribution
OPENROUTER_HTTP_REFERER=

# Security / routing policy
AI_DEFAULT_SENSITIVITY=confidential
AI_ALLOW_EXTERNAL_FOR_SENSITIVE=false
AI_REDACT_EXTERNAL=true

# Resource controls for free-tier operation
AI_TIMEOUT_MS=25000
AI_MAX_INPUT_CHARS=60000
AI_MAX_OUTPUT_TOKENS=4096
