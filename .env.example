# Total ARC AI Gateway
# Server-side only. Never prefix these variables with NEXT_PUBLIC_.

# Provider API keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Models
GEMINI_MODEL=gemini-3.8-flash
CLOUDFLARE_AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=openrouter/free

# Optional OpenRouter attribution
OPENROUTER_HTTP_REFERER=

# Security / routing policy
AI_DEFAULT_SENSITIVITY=confidential
AI_ALLOW_EXTERNAL_FOR_SENSITIVE=false
AI_REDACT_EXTERNAL=true

# Resource controls for free-tier operation
AI_TIMEOUT_MS=25000
AI_MAX_INPUT_CHARS=60000
AI_MAX_OUTPUT_TOKENS=4096


# Total ARC authentication / RBAC
# Use a cryptographically random value of at least 32 characters.
TOTAL_ARC_AUTH_SECRET=
# Initial admin is created only when AuthUser is empty and these credentials match.
TOTAL_ARC_BOOTSTRAP_ADMIN_EMAIL=
TOTAL_ARC_BOOTSTRAP_ADMIN_PASSWORD=
TOTAL_ARC_BOOTSTRAP_ADMIN_NAME=
# Used only by authorized production health-check automation.
TOTAL_ARC_HEALTHCHECK_TOKEN=

# Regulatory Intelligence scheduled monitor.
# Use a random secret >= 24 characters and store the same value as a GitHub Actions secret.
REGULATORY_MONITOR_CRON_SECRET=
# Optional on Vercel: Vercel Cron automatically uses CRON_SECRET as a Bearer token.
CRON_SECRET=
# GitHub Actions also needs TOTALARC_REGULATORY_MONITOR_URL as a repository secret,
# for example the production base URL without a trailing path.


# Vercel compatibility bridge (server-side only)
# Required only when TotalARC is deployed on Vercel. Cloudflare Workers uses
# the native DB binding from wrangler instead of these values.
CLOUDFLARE_ACCOUNT_ID=
TOTAL_ARC_D1_DATABASE_ID=
# Create a dedicated Cloudflare API token with only the D1 Read + D1 Write
# permissions needed by this database. Store it as a Sensitive/Secret variable.
CLOUDFLARE_D1_API_TOKEN=
# Optional. HTTP query timeout, clamped between 1000 and 60000 ms.
TOTAL_ARC_D1_HTTP_TIMEOUT_MS=15000


# cPanel / Passenger local database backend
# Leave unset or use "d1" to continue using Cloudflare D1 over HTTPS.
# Set to "sqlite" only after running and validating migrate:d1-to-sqlite.
TOTAL_ARC_DB_BACKEND=
# Use a persistent path outside the Git working tree on cPanel, for example:
# /home/technota/totalarc-data/totalarc.db
TOTAL_ARC_SQLITE_PATH=
# Migration-only safety controls. Do not keep overwrite enabled in normal runtime.
TOTAL_ARC_SQLITE_MIGRATE_OVERWRITE=0
TOTAL_ARC_SQLITE_MIGRATE_BATCH=500

# OpenAI API (server only; never use NEXT_PUBLIC_ for keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
