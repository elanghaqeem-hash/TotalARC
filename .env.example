# Required production database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/totalarc?sslmode=require"

# Required: generate a unique high-entropy value of at least 32 characters.
# Never commit or reuse the real production value.
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Platform administrators allowed to create institutions (comma separated)
PLATFORM_ADMIN_EMAILS="admin@example.com"

# Initial bootstrap admin (used only by npm run db:bootstrap-admin)
BOOTSTRAP_INSTITUTION_NAME="Your Institution"
BOOTSTRAP_INSTITUTION_SHORT_NAME="ORG"
BOOTSTRAP_ADMIN_NAME="Total ARC Administrator"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-strong-unique-password"

# Governed AI Gateway.
# Cloudflare Workers AI uses the non-secret "AI" Worker binding from wrangler.jsonc.
# External providers are considered configured only when both key and model are supplied.
CLOUDFLARE_AI_MODEL="@cf/qwen/qwen3-30b-a3b-fp8"

GEMINI_API_KEY=""
GEMINI_MODEL=""

GROQ_API_KEY=""
GROQ_MODEL=""

OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
OPENROUTER_HTTP_REFERER=""

# Confidential/restricted data stays on Cloudflare Workers AI by default.
AI_DEFAULT_SENSITIVITY="confidential"
AI_ALLOW_EXTERNAL_FOR_SENSITIVE="false"
AI_REDACT_EXTERNAL="true"
AI_TIMEOUT_MS="25000"
AI_MAX_INPUT_CHARS="60000"
AI_MAX_OUTPUT_TOKENS="4096"

# Optional additional trusted browser origins, comma separated.
# Keep empty for same-origin-only browser mutations.
ALLOWED_ORIGINS=""
