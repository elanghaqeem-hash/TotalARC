# Required production database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/totalarc?sslmode=require"

# Required: generate with at least 32 random bytes, never commit the real value
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-bytes"

# Platform administrators allowed to create institutions (comma separated)
PLATFORM_ADMIN_EMAILS="admin@example.com"

# Initial bootstrap admin (used only by npm run db:bootstrap-admin)
BOOTSTRAP_INSTITUTION_NAME="Your Institution"
BOOTSTRAP_INSTITUTION_SHORT_NAME="ORG"
BOOTSTRAP_ADMIN_NAME="Total ARC Administrator"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-strong-unique-password"

# Optional OpenAI-compatible AI provider. If absent, AI endpoints fail closed with 503.
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL=""

# Optional additional trusted browser origins, comma separated.
ALLOWED_ORIGINS=""
