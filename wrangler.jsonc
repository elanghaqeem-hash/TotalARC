// TotalARC Cloudflare Workers deployment configuration.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "totalarc",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "totalarc"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "ratelimits": [
    {
      "name": "AI_CHAT_RATE_LIMIT",
      "namespace_id": "571001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "AI_ANALYZE_RATE_LIMIT",
      "namespace_id": "571002",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ],
  "vars": {
    "AI_DEFAULT_SENSITIVITY": "confidential",
    "AI_ALLOW_EXTERNAL_FOR_SENSITIVE": "false",
    "AI_REDACT_EXTERNAL": "true",
    "CLOUDFLARE_AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "GEMINI_MODEL": "gemini-3.8-flash",
    "GROQ_MODEL": "openai/gpt-oss-20b",
    "OPENROUTER_MODEL": "openrouter/free"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true
}
